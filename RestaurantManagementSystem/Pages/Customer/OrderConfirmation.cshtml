@page
@model RestaurantManagementSystem.Pages.Customer.OrderConfirmationModel

@{
    ViewData["Title"] = "Order Confirmation";
    Layout = "_CustomerLayout";
    ViewData["ActivePage"] = "Orders";
}

<div class="order-wrapper">
    <div class="order-card text-center py-5 mb-4">
        <div class="auth-icon mb-3" style="width: 80px; height: 80px; font-size: 2.2rem;">
            <i class="fa-solid fa-check"></i>
        </div>
        <h2 class="fw-bold text-main mb-1">Order Confirmed!</h2>
        <p class="text-muted">Your order has been successfully placed and registered.</p>
        <div class="mt-3">
            <span class="status-pill status-pending fs-6 px-4 py-2">
                Order Reference: #ORD-@Model.Order?.OrderId.ToString("D5")
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Details Card -->
        <div class="col-md-5">
            <div class="order-card h-100">
                <h5 class="fw-bold mb-3" style="color: var(--text-main);">
                    <i class="fa-solid fa-circle-info text-primary me-2"></i>Dine-In Summary
                </h5>
                <hr class="text-muted opacity-25" />

                <div class="mb-3">
                    <span class="order-meta d-block">Order Status</span>
                    @if (Model.Order?.Status == "Pending")
                    {
                        <span class="status-pill status-pending mt-1">Pending</span>
                    }
                    else if (Model.Order?.Status == "Completed" || Model.Order?.Status == "Served")
                    {
                        <span class="status-pill status-served mt-1">Completed</span>
                    }
                    else
                    {
                        <span class="status-pill status-other mt-1">@Model.Order?.Status</span>
                    }
                </div>

                <div class="mb-3">
                    <span class="order-meta d-block">Assigned Table</span>
                    <strong class="text-main">
                        @if (Model.Order?.Table != null)
                        {
                            @:Table @Model.Order.Table.TableNumber (@Model.Order.Table.DiningArea)
                        }
                        else
                        {
                            <span class="text-muted">Not assigned</span>
                        }
                    </strong>
                </div>

                <div class="mb-3">
                    <span class="order-meta d-block">Scheduled Date & Time</span>
                    <strong class="text-main">@Model.Order?.DineInDateTime.ToString("dd MMM yyyy, hh:mm tt")</strong>
                </div>
            </div>
        </div>

        <!-- Ordered Items Summary Card -->
        <div class="col-md-7">
            <div class="order-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-3" style="color: var(--text-main);">
                        <i class="fa-solid fa-receipt text-primary me-2"></i>Ordered Items
                    </h5>
                    <hr class="text-muted opacity-25" />

                    @if (Model.Order?.OrderItems != null && Model.Order.OrderItems.Any())
                    {
                        @foreach (var item in Model.Order.OrderItems)
                        {
                            <div class="order-item-row">
                                <div>
                                    <span class="fw-semibold">@(item.Menu?.MenuName ?? "Item")</span>
                                    <span class="qty">x @item.Quantity</span>
                                </div>
                                <span class="fw-semibold">RM @item.Subtotal.ToString("0.00")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small">No items listed.</p>
                    }
                </div>

                <div class="order-total-row mt-4 pt-3">
                    <span>Total Amount</span>
                    <span class="amount">RM @Model.Order?.TotalAmount.ToString("0.00")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="text-center mt-5 mb-4">
        <a asp-page="/Customer/MyOrders" class="btn-action text-decoration-none px-4 py-3 d-inline-block">
            <i class="fa-solid fa-list-check me-2"></i> View My Orders History
        </a>
    </div>
</div>