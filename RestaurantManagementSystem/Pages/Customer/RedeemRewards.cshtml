@page
@model RestaurantManagementSystem.Pages.Customer.RedeemRewardsModel

@{
    ViewData["Title"] = "Rewards Redemption";
    ViewData["ActivePage"] = "Rewards";
    ViewData["CustomerName"] = Model.DisplayName;
    Layout = "_CustomerLayout";

    bool hasActiveDrink = Model.RedeemedCodes != null && Model.RedeemedCodes.Any(v => v.RewardName.Trim().Equals("Free Drink of Choice", StringComparison.OrdinalIgnoreCase) && !v.IsUsed);
    bool hasActiveDessert = Model.RedeemedCodes != null && Model.RedeemedCodes.Any(v => v.RewardName.Trim().Equals("Free Dessert", StringComparison.OrdinalIgnoreCase) && !v.IsUsed);
    bool hasActiveVoucher = Model.RedeemedCodes != null && Model.RedeemedCodes.Any(v => v.RewardName.Trim().Equals("RM10 Discount Voucher", StringComparison.OrdinalIgnoreCase) && !v.IsUsed);
}

<div class="container py-4">

    <!-- Header & Points Balance Banner -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="bg-white rounded-5 p-4 p-md-5 shadow-sm border-0 d-flex flex-column flex-md-row justify-content-between align-items-center gap-4" style="background: linear-gradient(135deg, #FFF9E6 0%, #FFFFFF 100%);">
                <div>
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">
                        <i class="fa-solid fa-crown me-1"></i> Member Perks
                    </span>
                    <h2 class="fw-bold m-0" style="color: #2D3436;">Rewards Store</h2>
                    <p class="text-muted m-0 mt-1">Spend your loyalty points on free treats, drinks, and cash vouchers!</p>
                </div>
                <div class="text-center px-4 py-3 rounded-4 bg-white shadow-sm border text-md-end">
                    <span class="text-muted small d-block">Available Points</span>
                    <h2 class="fw-bold text-success m-0"><i class="fa-solid fa-coins text-warning me-2"></i>@Model.CustomerLoyaltyPoints <span class="fs-6 text-muted">pts</span></h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Messages -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Rewards Grid Catalog -->
    <div class="row g-4 mb-5">
        
        <!-- Reward 1: Free Drink -->
        <div class="col-md-4">
            <div class="bg-white rounded-5 p-4 shadow-sm border-0 h-100 d-flex flex-column justify-content-between text-center">
                <div>
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-warning mb-3 shadow-sm" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="fa-solid fa-mug-hot"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Free Drink of Choice</h4>
                    <p class="text-muted small">Choose any regular beverage, tea, or coffee from our menu catalog.</p>
                </div>
                <div class="mt-4">
                    <div class="fw-bold text-primary fs-5 mb-3">150 Points</div>
                    <form method="post" asp-page-handler="Redeem">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="rewardName" value="Free Drink of Choice" />
                        <input type="hidden" name="pointsCost" value="150" />
                        <button type="submit" class="btn @(hasActiveDrink ? "btn-secondary" : "btn-warning text-dark") fw-bold w-100 rounded-pill py-2 shadow-sm @(hasActiveDrink || Model.CustomerLoyaltyPoints < 150 ? "disabled" : "")" @(hasActiveDrink ? "disabled" : "")>
                            @(hasActiveDrink ? "Already Redeemed" : "Redeem Reward")
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Reward 2: Free Dessert -->
        <div class="col-md-4">
            <div class="bg-white rounded-5 p-4 shadow-sm border-0 h-100 d-flex flex-column justify-content-between text-center">
                <div>
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-danger mb-3 shadow-sm" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="fa-solid fa-ice-cream"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Free Dessert</h4>
                    <p class="text-muted small">Treat yourself to any delicious dessert or pastry on the menu.</p>
                </div>
                <div class="mt-4">
                    <div class="fw-bold text-primary fs-5 mb-3">300 Points</div>
                    <form method="post" asp-page-handler="Redeem">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="rewardName" value="Free Dessert" />
                        <input type="hidden" name="pointsCost" value="300" />
                        <button type="submit" class="btn @(hasActiveDessert ? "btn-secondary" : "btn-warning text-dark") fw-bold w-100 rounded-pill py-2 shadow-sm @(hasActiveDessert || Model.CustomerLoyaltyPoints < 300 ? "disabled" : "")" @(hasActiveDessert ? "disabled" : "")>
                            @(hasActiveDessert ? "Already Redeemed" : "Redeem Reward")
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Reward 3: RM10 Voucher -->
        <div class="col-md-4">
            <div class="bg-white rounded-5 p-4 shadow-sm border-0 h-100 d-flex flex-column justify-content-between text-center">
                <div>
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-success mb-3 shadow-sm" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="fa-solid fa-ticket"></i>
                    </div>
                    <h4 class="fw-bold text-dark">RM10 Discount Voucher</h4>
                    <p class="text-muted small">Get an instant RM10 off your next total order billing amount.</p>
                </div>
                <div class="mt-4">
                    <div class="fw-bold text-primary fs-5 mb-3">500 Points</div>
                    <form method="post" asp-page-handler="Redeem">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="rewardName" value="RM10 Discount Voucher" />
                        <input type="hidden" name="pointsCost" value="500" />
                        <button type="submit" class="btn @(hasActiveVoucher ? "btn-secondary" : "btn-warning text-dark") fw-bold w-100 rounded-pill py-2 shadow-sm @(hasActiveVoucher || Model.CustomerLoyaltyPoints < 500 ? "disabled" : "")" @(hasActiveVoucher ? "disabled" : "")>
                            @(hasActiveVoucher ? "Already Redeemed" : "Redeem Reward")
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>

    <!-- MY REDEEMED CODES SECTION (BOTTOM) -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h4 class="fw-bold mb-3" style="color: #2D3436;">
                    <i class="fa-solid fa-ticket text-warning me-2"></i>My Active Redeemed Vouchers
                </h4>

                @if (Model.RedeemedCodes == null || !Model.RedeemedCodes.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa-solid fa-folder-open fa-2x opacity-50 mb-2"></i>
                        <p class="mb-0 small">You haven't redeemed any rewards yet. Redeem your points above to get promo codes!</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="py-3 rounded-start">Reward Name</th>
                                    <th class="py-3">Promo Code</th>
                                    <th class="py-3">Status</th>
                                    <th class="py-3">Redeemed Date</th>
                                    <th class="py-3 text-end rounded-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RedeemedCodes)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@item.RewardName</td>
                                        <td>
                                            <span class="badge bg-warning text-dark px-3 py-2 font-monospace fs-6">@item.PromoCode</span>
                                        </td>
                                        <td>
                                            @if (item.IsUsed)
                                            {
                                                <span class="badge bg-secondary">Used</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@item.RedeemedDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                                        <td class="text-end">
                                            <div class="d-flex align-items-center justify-content-end gap-2">
                                                @if (!item.IsUsed)
                                                {
                                                    <a href="/Customer/OrderPortal?code=@item.PromoCode" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-bold">
                                                        Use in Order <i class="fa-solid fa-arrow-right ms-1"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-light text-muted rounded-pill px-3 fw-bold" disabled>Redeemed</button>
                                                }

                                                <form method="post" asp-page-handler="HideVoucher" style="display:inline;" onsubmit="return confirm('Remove this voucher from your list?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="voucherId" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-1" style="width: 32px; height: 32px;" title="Hide Voucher">
                                                        <i class="fa-solid fa-trash-can"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

</div>