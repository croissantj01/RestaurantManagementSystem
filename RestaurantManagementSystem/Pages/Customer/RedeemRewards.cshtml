@page
@model RestaurantManagementSystem.Pages.Customer.RedeemRewardsModel

@{
    ViewData["Title"] = "Rewards Redemption";
    ViewData["ActivePage"] = "Rewards";
    ViewData["CustomerName"] = Model.DisplayName;
    Layout = "_CustomerLayout";
}

<div class="container py-4">

    <!-- Header & Points Balance Banner -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="bg-white rounded-5 p-4 p-md-5 shadow-sm border-0 d-flex flex-column flex-md-row justify-content-between align-items-center gap-4" style="background: linear-gradient(135deg, #FFF9E6 0%, #FFFFFF 100%);">
                <div>
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">
                        <i class="fa-solid fa-crown me-1"></i> Member Perks
                    </span>
                    <h2 class="fw-bold m-0" style="color: #2D3436;">Rewards Store</h2>
                    <p class="text-muted m-0 mt-1">Spend your loyalty points on free treats, drinks, and cash vouchers!</p>
                </div>
                <div class="text-center px-4 py-3 rounded-4 bg-white shadow-sm border text-md-end">
                    <span class="text-muted small d-block">Available Points</span>
                    <h2 class="fw-bold text-success m-0"><i class="fa-solid fa-coins text-warning me-2"></i>@Model.CustomerLoyaltyPoints <span class="fs-6 text-muted">pts</span></h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Messages -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Rewards Grid Catalog -->
    <div class="row g-4">
        
        <!-- Reward 1: Free Drink -->
        <div class="col-md-4">
            <div class="bg-white rounded-5 p-4 shadow-sm border-0 h-100 d-flex flex-column justify-content-between text-center">
                <div>
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-warning mb-3 shadow-sm" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="fa-solid fa-mug-hot"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Free Drink of Choice</h4>
                    <p class="text-muted small">Choose any regular beverage, tea, or coffee from our menu catalog.</p>
                </div>
                <div class="mt-4">
                    <div class="fw-bold text-primary fs-5 mb-3">150 Points</div>
                    <form method="post" asp-page-handler="Redeem">
                        <input type="hidden" name="rewardName" value="Free Drink of Choice" />
                        <input type="hidden" name="pointsCost" value="150" />
                        <button type="submit" class="btn btn-warning text-dark fw-bold w-100 rounded-pill py-2 shadow-sm @(Model.CustomerLoyaltyPoints < 150 ? "disabled" : "")">
                            Redeem Reward
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Reward 2: Free Dessert -->
        <div class="col-md-4">
            <div class="bg-white rounded-5 p-4 shadow-sm border-0 h-100 d-flex flex-column justify-content-between text-center">
                <div>
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-danger mb-3 shadow-sm" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="fa-solid fa-ice-cream"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Free Dessert</h4>
                    <p class="text-muted small">Treat yourself to any delicious dessert or pastry on the menu.</p>
                </div>
                <div class="mt-4">
                    <div class="fw-bold text-primary fs-5 mb-3">300 Points</div>
                    <form method="post" asp-page-handler="Redeem">
                        <input type="hidden" name="rewardName" value="Free Dessert" />
                        <input type="hidden" name="pointsCost" value="300" />
                        <button type="submit" class="btn btn-warning text-dark fw-bold w-100 rounded-pill py-2 shadow-sm @(Model.CustomerLoyaltyPoints < 300 ? "disabled" : "")">
                            Redeem Reward
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Reward 3: RM10 Voucher -->
        <div class="col-md-4">
            <div class="bg-white rounded-5 p-4 shadow-sm border-0 h-100 d-flex flex-column justify-content-between text-center">
                <div>
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-success mb-3 shadow-sm" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="fa-solid fa-ticket"></i>
                    </div>
                    <h4 class="fw-bold text-dark">RM10 Discount Voucher</h4>
                    <p class="text-muted small">Get an instant RM10 off your next total order billing amount.</p>
                </div>
                <div class="mt-4">
                    <div class="fw-bold text-primary fs-5 mb-3">500 Points</div>
                    <form method="post" asp-page-handler="Redeem">
                        <input type="hidden" name="rewardName" value="RM10 Discount Voucher" />
                        <input type="hidden" name="pointsCost" value="500" />
                        <button type="submit" class="btn btn-warning text-dark fw-bold w-100 rounded-pill py-2 shadow-sm @(Model.CustomerLoyaltyPoints < 500 ? "disabled" : "")">
                            Redeem Reward
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>