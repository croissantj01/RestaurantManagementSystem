@page
@model RestaurantManagementSystem.Pages.Customer.RegisterModel

@{
    ViewData["Title"] = "Customer Registration";
    Layout = "_AuthLayout";
}

<div class="auth-shell">

    <!-- Left food photo -->
    <div class="auth-side">
        <div class="auth-side-text">
            <h3><i class="fa-solid fa-utensils"></i>MyCafe</h3>
            <p>Join us to reserve tables and order your favourite meals.</p>
        </div>
    </div>

    <!-- Right form panel -->
    <div class="auth-main">
        <div class="auth-main-body">

            <div class="auth-icon"><i class="fa-solid fa-user-plus"></i></div>
            <h2 class="auth-title">SIGN UP</h2>

            <form method="post" class="auth-form">

                <div class="auth-field">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                        <input asp-for="Customer.FullName" class="form-control" placeholder="Full name" />
                    </div>
                    <span asp-validation-for="Customer.FullName" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                        <input asp-for="Customer.Email" class="form-control" placeholder="Email" />
                    </div>
                    <span asp-validation-for="Customer.Email" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
                        <input asp-for="Customer.Phone" class="form-control" placeholder="Phone number" />
                    </div>
                    <span asp-validation-for="Customer.Phone" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                        <input asp-for="Customer.Password" type="password" class="form-control" placeholder="Password" />
                    </div>
                    <span asp-validation-for="Customer.Password" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-auth">REGISTER</button>
                </div>

            </form>
        </div>

        <div class="auth-bottom">
            Already have an account? <a asp-page="/Customer/Login">Login</a>
        </div>
    </div>

</div>