@page
@model RestaurantManagementSystem.Pages.Customer.MakeOrderModel

@{
    ViewData["Title"] = "Make Order";
    Layout = "_CustomerLayout";
    ViewData["ActivePage"] = "MakeOrder";
}

<div class="order-wrapper">
    <div class="reserve-card mb-5">
        <div class="reserve-header">
            <div class="reserve-header-icon">
                <i class="fa-solid fa-utensils"></i>
            </div>
            <h2>Make Your Order</h2>
            <p>Select your table, dine-in date/time, and choose your favorite dishes.</p>
        </div>

        <div class="reserve-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 p-3 mb-4"></div>

                <!-- ================================= -->
                <!-- SECTION 1: DINE-IN INFORMATION -->
                <!-- ================================= -->
                <h5 class="fw-bold mb-3" style="color: var(--text-main);">1. Dine-In Information</h5>
                
                <div class="row g-3 mb-4">
                    <!-- TABLE SELECTION -->
                    <div class="col-md-4">
                        <label asp-for="Order.TableId" class="form-label">Select Table</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-chair"></i></span>
                            <select asp-for="Order.TableId" class="form-select">
                                <option value="">-- Select Table --</option>
                                @foreach (var table in Model.Tables)
                                {
                                    <option value="@table.RestaurantTableId">
                                        Table @table.TableNumber (@table.DiningArea - Capacity: @table.Capacity)
                                    </option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="Order.TableId" class="settings-error"></span>
                        @if (Model.Tables.Count == 0)
                        {
                            <div class="settings-error mt-1">No tables are currently available.</div>
                        }
                    </div>

                    <!-- DINE-IN DATE -->
                    <div class="col-md-4">
                        <label asp-for="DineInDate" class="form-label">Dine-In Date</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-calendar-days"></i></span>
                            <input asp-for="DineInDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <!-- DINE-IN TIME (Hour, Minute, AM/PM) -->
                    <div class="col-md-4">
                        <label class="form-label">Dine-In Time</label>
                        <div class="row g-2">
                            <div class="col-4">
                                <select asp-for="SelectedHour" class="form-select rounded-3">
                                    @for (int hour = 1; hour <= 12; hour++)
                                    {
                                        <option value="@hour">@hour.ToString("00")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-4">
                                <select asp-for="SelectedMinute" class="form-select rounded-3">
                                    @for (int minute = 0; minute < 60; minute += 5)
                                    {
                                        <option value="@minute">@minute.ToString("00")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-4">
                                <select asp-for="SelectedAmPm" class="form-select rounded-3">
                                    <option value="AM">AM</option>
                                    <option value="PM">PM</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4 text-muted opacity-25" />

                <!-- ================================= -->
                <!-- SECTION 2: SELECT FOOD -->
                <!-- ================================= -->
                <h5 class="fw-bold mb-3" style="color: var(--text-main);">2. Choose Menu Items</h5>

                @if (Model.Menus.Count == 0)
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-utensils"></i>
                        <p class="mb-0">No menu items are currently available.</p>
                    </div>
                }
                else
                {
                    <div class="row g-4 mb-4">
                        @foreach (var menu in Model.Menus)
                        {
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="product-card h-100">
                                    <div>
                                        <div class="img-container">
                                            @if (!string.IsNullOrEmpty(menu.ImagePath))
                                            {
                                                <img src="@menu.ImagePath" alt="@menu.MenuName" />
                                            }
                                            else
                                            {
                                                <img src="https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=400&q=80" alt="Default Food" />
                                            }
                                        </div>

                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h3 class="card-title-custom">@menu.MenuName</h3>
                                            <span class="card-price-custom">RM @menu.Price.ToString("0.00")</span>
                                        </div>

                                        <p class="card-description-custom">@menu.Description</p>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-2">
                                        <span class="text-muted fw-semibold" style="font-size: 13px;">Quantity:</span>
                                        <div class="qty-box">
                                            <button type="button" class="qty-btn" onclick="adjustQty(@menu.Id, -1)">-</button>
                                            <input type="number" id="qty_@menu.Id" name="Quantities[@menu.Id]" value="0" min="0" class="qty-input" />
                                            <button type="button" class="qty-btn" onclick="adjustQty(@menu.Id, 1)">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- ================================= -->
                <!-- STICKY CHECKOUT BAR -->
                <!-- ================================= -->
                <div class="order-bar">
                    <a asp-page="/Customer/Dashboard" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold border-0">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back
                    </a>
                    <button type="submit" class="btn-reserve" style="width: auto; padding: 10px 32px;">
                        Confirm & Place Order <i class="fa-solid fa-arrow-right ms-1"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function adjustQty(menuId, amount) {
            const input = document.getElementById('qty_' + menuId);
            if (input) {
                let currentVal = parseInt(input.value) || 0;
                let newVal = currentVal + amount;
                if (newVal < 0) newVal = 0;
                input.value = newVal;
            }
        }
    </script>
}