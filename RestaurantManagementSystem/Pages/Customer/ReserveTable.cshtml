@page
@using Microsoft.AspNetCore.Http
@model RestaurantManagementSystem.Pages.Customer.ReserveTableModel

@{
    ViewData["Title"] = "Reserve a Table";
    ViewData["ActivePage"] = "Bookings";
    ViewData["CustomerName"] = Model.HttpContext.Session.GetString("CustomerName") ?? "Guest";
    Layout = "_CustomerLayout";
}

<div class="reserve-wrapper">
    <div class="reserve-card">

        <!-- Header -->
        <div class="reserve-header">
            <div class="reserve-header-icon"><i class="fa-solid fa-chair"></i></div>
            <h2>Reserve a Table</h2>
            <p>Pick your table, date and time. Each booking lasts 2 hours.</p>
        </div>

        <!-- Form -->
        <div class="reserve-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger rounded-4">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form method="post">

                <!-- Table -->
                <div class="mb-4">
                    <label asp-for="SelectedTableId" class="form-label">Table</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-chair"></i></span>
                        <select asp-for="SelectedTableId" class="form-select">
                            <option value="">Select a table</option>
                            @foreach (var table in Model.Tables)
                            {
                                <option value="@table.RestaurantTableId">
                                    @table.TableNumber · @table.DiningArea · Seats @table.Capacity
                                </option>
                            }
                        </select>
                    </div>

                    @if (Model.Tables.Count == 0)
                    {
                        <div class="text-danger small mt-2">
                            No tables are available for the selected date and time.
                        </div>
                    }

                    <span asp-validation-for="SelectedTableId" class="text-danger small"></span>
                </div>

                <!-- Date & Time -->
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="ReservationDate" class="form-label">Date</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-calendar-days"></i></span>
                            <input asp-for="ReservationDate" type="date" class="form-control" />
                        </div>
                        <span asp-validation-for="ReservationDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="ReservationTime" class="form-label">Time</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-clock"></i></span>
                            <input asp-for="ReservationTime" type="time" class="form-control" />
                        </div>
                        <span asp-validation-for="ReservationTime" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Guests -->
                <div class="mb-4">
                    <label asp-for="NumberOfGuests" class="form-label">Guests</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-users"></i></span>
                        <input asp-for="NumberOfGuests" type="number" min="1" class="form-control" />
                    </div>
                    <div class="reserve-hint">Make sure the table you pick fits your group.</div>
                    <span asp-validation-for="NumberOfGuests" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-reserve">
                    <i class="fa-solid fa-check me-2"></i>Confirm Reservation
                </button>

            </form>
        </div>
    </div>
</div>