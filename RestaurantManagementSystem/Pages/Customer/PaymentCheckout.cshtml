@page "{orderId:int}"
@model RestaurantManagementSystem.Pages.Customer.PaymentCheckoutModel

@{
    ViewData["Title"] = "Stripe Payment Gateway";
    Layout = "_CustomerLayout";

    // Estimate loyalty points to be earned (1 point per RM 1 spent)
    int estimatedPoints = Model.Order != null ? (int)Math.Floor(Model.Order.TotalAmount) : 0;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-5 p-4 p-md-5 bg-white text-center">
                
                <!-- Stripe Branding Header -->
                <div class="mb-4">
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-primary mb-3 shadow-sm" style="width: 85px; height: 85px;">
                        <i class="fa-brands fa-stripe display-4" style="color: #635bff;"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Stripe Payment Gateway</h3>
                    <p class="text-muted small mb-0">Order Reference: <strong class="text-dark">#ORD-@Model.OrderId.ToString("D5")</strong></p>
                </div>

                <!-- Payment & Rewards Summary Box -->
                <div class="p-3 mb-4 rounded-4 text-start" style="background-color: #f8f9fa; border: 1px dashed #dee2e6;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Total Amount Payable</span>
                        <span class="fw-bold fs-4" style="color: #d97706;">RM @(Model.Order?.TotalAmount.ToString("N2") ?? "0.00")</span>
                    </div>
                    
                    <hr class="my-2 text-muted opacity-25" />

                    <div class="d-flex justify-content-between align-items-center pt-1">
                        <span class="small text-muted">
                            <i class="fa-solid fa-crown text-warning me-1"></i> Loyalty Points You'll Earn:
                        </span>
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold rounded-pill px-3 py-1">
                            +@estimatedPoints pts
                        </span>
                    </div>
                </div>

                <!-- Post to backend handler to initiate Stripe API Session -->
                <form method="post" asp-page-handler="ProcessPayment" asp-route-orderId="@Model.OrderId">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn text-white w-100 rounded-pill py-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3" style="background-color: #635bff; border: none; font-size: 1.05rem;">
                        <i class="fa-solid fa-lock me-1"></i> Pay with Stripe Gateway &rarr;
                    </button>
                </form>

                <div class="text-muted small mb-3">
                    <i class="fa-solid fa-shield-halved text-muted me-1"></i> You will be redirected to Stripe's secure portal to enter your card details.
                </div>

                <!-- Return link -->
                <div>
                    <a asp-page="/Customer/OrderPortal" class="text-muted text-decoration-none small d-inline-flex align-items-center gap-1">
                        <i class="fa-solid fa-arrow-left"></i> Return to Menu &amp; Cart
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>