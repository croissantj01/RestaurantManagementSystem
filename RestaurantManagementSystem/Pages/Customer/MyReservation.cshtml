@page
@using Microsoft.AspNetCore.Http
@model RestaurantManagementSystem.Pages.Customer.MyReservationModel

@{
    ViewData["Title"] = "My Bookings & Orders";
    ViewData["ActivePage"] = "Bookings";
    ViewData["CustomerName"] = Model.HttpContext.Session.GetString("CustomerName") ?? "Guest";
    Layout = "_CustomerLayout";
}

<style>
    /* Clickable 5-star picker (DOM order is 5 -> 1, reversed visually so hover fills left to right) */
    .star-rating {
        display: inline-flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        position: relative;
    }

        .star-rating input {
            position: absolute;
            opacity: 0;
            width: 1px;
            height: 1px;
        }

        .star-rating label {
            font-size: 1.7rem;
            line-height: 1;
            color: #d9d9d9;
            cursor: pointer;
            padding: 0 2px;
            transition: color 0.15s ease;
        }

            .star-rating input:checked ~ label,
            .star-rating label:hover,
            .star-rating label:hover ~ label {
                color: #f59e0b;
            }

    .star-static .star-on {
        color: #f59e0b;
    }

    .star-static .star-off {
        color: #d9d9d9;
    }

    .star-static span {
        font-size: 1.2rem;
    }
</style>

<div class="my-4">
    <!-- Page Header Section -->
    <div class="mb-4">
        <h2 class="page-header-title mb-1">My Bookings & Orders</h2>
        <p class="text-muted mb-0">View table-only bookings and dine-in orders with food.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Status Pills Bar -->
    <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
        <button class="btn btn-sm btn-dark rounded-pill px-4 py-2 fw-bold">All</button>
        <button class="btn btn-sm btn-light rounded-pill px-4 py-2 text-muted fw-semibold bg-white shadow-sm">Active</button>
        <button class="btn btn-sm btn-light rounded-pill px-4 py-2 text-muted fw-semibold bg-white shadow-sm">Completed</button>
        <button class="btn btn-sm btn-light rounded-pill px-4 py-2 text-muted fw-semibold bg-white shadow-sm">Cancelled</button>
    </div>

    @if (Model.Bookings == null || !Model.Bookings.Any())
    {
        <div class="data-card">
            <div class="empty-state py-5">
                <div><i class="fa-solid fa-calendar-xmark fs-1 text-muted mb-3"></i></div>
                <h5 class="fw-bold" style="color: var(--text-main);">No bookings or food orders yet</h5>
                <p class="text-muted mb-0">You do not have any active bookings. Reserve a table or order food to get started.</p>
            </div>
        </div>
    }
    else
    {
        <!-- Modern Card Grid Layout matching the mockup -->
        <div class="row g-4">
            @foreach (var booking in Model.Bookings)
            {
                DateTime endDateTime = booking.StartTime.AddHours(2);
                string key = (booking.Type == "Table Only" ? "R" : "O") + booking.Id;

                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white d-flex flex-column justify-content-between">
                        <div>
                            <!-- Card Header: Table Badge & Status -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 48px; height: 48px; background-color: var(--primary-color); font-size: 1.1rem;">
                                        T@(booking.TableNumber)
                                    </div>
                                    <div>
                                        <h6 class="fw-bold m-0" style="color: var(--text-main);">Table @booking.TableNumber</h6>
                                        <small class="text-muted">@booking.DiningArea</small>
                                    </div>
                                </div>

                                <div>
                                    @if (booking.IsCompleted)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-1.5 rounded-pill fw-bold" style="font-size: 11px;">
                                            <i class="fa-solid fa-check-double me-1"></i> Completed
                                        </span>
                                    }
                                    else if (booking.Status == "Reserved")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-1.5 rounded-pill fw-bold" style="font-size: 11px;">
                                            <i class="fa-solid fa-check me-1"></i> Active
                                        </span>
                                    }
                                    else if (booking.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1.5 rounded-pill fw-bold" style="font-size: 11px;">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-1.5 rounded-pill fw-bold" style="font-size: 11px;">
                                            @booking.Status
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Date, Time & Type Subheader -->
                            <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom text-muted" style="font-size: 12.5px;">
                                <span><i class="fa-regular fa-calendar me-1"></i> @booking.Date.ToString("ddd, MMM dd, yyyy")</span>
                                <span><i class="fa-regular fa-clock me-1"></i> @booking.StartTime.ToString("hh:mm tt")</span>
                            </div>

                            <!-- Booking Type Tag -->
                            <div class="mb-3">
                                @if (booking.Type == "Table + Food Order")
                                {
                                    <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill" style="font-size: 11px;">
                                        <i class="fa-solid fa-utensils me-1"></i> Table + Food Order
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2.5 py-1 rounded-pill" style="font-size: 11px;">
                                        <i class="fa-solid fa-chair me-1"></i> Table Only Booking
                                    </span>
                                }
                            </div>

                            <!-- Order Items Mini Table / List -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between text-muted small fw-bold mb-2 border-bottom pb-1">
                                    <span>Items</span>
                                    <span>Qty</span>
                                </div>

                                @if (booking.OrderItems != null && booking.OrderItems.Any())
                                {
                                    <div style="max-height: 120px; overflow-y: auto;">
                                        @foreach (var item in booking.OrderItems)
                                        {
                                            <div class="d-flex justify-content-between align-items-center py-1 small">
                                                <span class="text-dark">@(item.Menu?.MenuName ?? "Item")</span>
                                                <span class="text-muted">x@(item.Quantity)</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small italic mb-0">No food pre-ordered for this table reservation.</p>
                                }
                            </div>

                            <!-- Review Section (only for completed bookings) -->
                            @if (booking.IsCompleted)
                            {
                                <div class="pt-3 border-top">
                                    @if (booking.ReviewRating.HasValue)
                                    {
                                        <div class="small fw-bold mb-1" style="color: var(--text-main);">Your Review</div>
                                        <div class="star-static">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                <span class="@(s <= booking.ReviewRating.Value ? "star-on" : "star-off")">&#9733;</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(booking.ReviewComment))
                                        {
                                            <p class="small text-muted mb-0 mt-1">@booking.ReviewComment</p>
                                        }
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-warning btn-sm rounded-pill px-3 fw-bold" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#review-@(key)" aria-expanded="false">
                                            <i class="fa-regular fa-star me-1"></i> Leave a Review
                                        </button>

                                        <div class="collapse mt-3" id="review-@(key)">
                                            <form method="post" asp-page-handler="Review" class="m-0">
                                                <input type="hidden" name="id" value="@booking.Id" />
                                                <input type="hidden" name="type" value="@booking.Type" />

                                                <div class="small fw-bold mb-1">How was your experience?</div>
                                                <div class="star-rating mb-2">
                                                    @for (int s = 5; s >= 1; s--)
                                                    {
                                                        <input type="radio" id="star-@(key)-@(s)" name="rating" value="@s" required />
                                                        <label for="star-@(key)-@(s)" title="Rate @s out of 5">&#9733;</label>
                                                    }
                                                </div>

                                                <textarea name="comment" rows="3" class="form-control form-control-sm review-comment"
                                                          placeholder="Tell us more (optional, max 100 words)"></textarea>

                                                <div class="d-flex justify-content-between align-items-center mt-2">
                                                    <small class="word-count text-muted">0 / 100 words</small>
                                                    <button type="submit" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold text-white review-submit">
                                                        Submit Review
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Card Footer: Total Amount & Action Button -->
                        <div class="pt-3 border-top d-flex align-items-center justify-content-between mt-3">
                            <div>
                                <small class="text-muted d-block" style="font-size: 11px;">Total Amount</small>
                                <span class="fw-bold fs-5" style="color: var(--primary-color);">RM @booking.TotalAmount.ToString("N2")</span>
                            </div>

                            <div>
                                @if (booking.Status == "Cancelled")
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-1 rounded-pill" style="font-size: 11px;">Cancelled</span>

                                        <!-- Trash Can Button to Hide Cancelled Bookings -->
                                        <form method="post" asp-page-handler="Hide" class="m-0 d-inline">
                                            <input type="hidden" name="id" value="@booking.Id" />
                                            <input type="hidden" name="type" value="@booking.Type" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px;" title="Hide from list" onclick="return confirm('Do you want to remove this from your list?');">
                                                <i class="fa-solid fa-trash-can" style="font-size: 12px;"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else if (!booking.IsCompleted)
                                {
                                    <form method="post" asp-page-handler="Cancel" class="m-0 d-inline">
                                        <input type="hidden" name="id" value="@booking.Id" />
                                        <input type="hidden" name="type" value="@booking.Type" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-bold" onclick="return confirm('Are you sure you want to cancel this booking?');">
                                            Cancel Booking
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // Optional filter button interaction logic
        document.querySelectorAll('.btn-light, .btn-dark').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.btn-dark').forEach(b => {
                    b.classList.remove('btn-dark', 'text-white');
                    b.classList.add('btn-light', 'text-muted', 'bg-white', 'shadow-sm');
                });
                this.classList.remove('btn-light', 'text-muted', 'bg-white', 'shadow-sm');
                this.classList.add('btn-dark', 'text-white');
            });
        });

        // Live word counter for review text (max 100 words)
        document.querySelectorAll('.review-comment').forEach(function (textarea) {
            var form = textarea.closest('form');
            var counter = form.querySelector('.word-count');
            var submitBtn = form.querySelector('.review-submit');

            function updateCount() {
                var words = textarea.value.trim().split(/\s+/).filter(Boolean).length;
                counter.textContent = words + ' / 100 words';
                var tooLong = words > 100;
                counter.classList.toggle('text-danger', tooLong);
                counter.classList.toggle('text-muted', !tooLong);
                submitBtn.disabled = tooLong;
            }

            textarea.addEventListener('input', updateCount);
            updateCount();
        });
    </script>
}