@page
@model RestaurantManagementSystem.Pages.Customer.OrderPortalModel

@{
    ViewData["Title"] = "Order & Menu Portal";
    Layout = "_CustomerLayout";
    ViewData["ActivePage"] = "Menu";
}

<style>
    .btn-outline-custom {
        border-color: #d97706 !important;
        color: #d97706 !important;
    }
    .btn-outline-custom:hover, .btn-outline-custom.active {
        background-color: #d97706 !important;
        color: #fff !important;
    }
    .text-yellow-price {
        color: #d97706 !important;
    }
</style>

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- MAIN SECTION: MENU CONTENT + TOP-ALIGNED ORDER SUMMARY -->
    <div class="row g-4 align-items-start">
        <!-- LEFT / CENTER: MENU CONTENT -->
        <div class="col-lg-8">
            <h2 class="fw-bold mb-3" style="color: var(--text-main);">Choose Category &amp; Dishes</h2>

            <!-- SEARCH BAR -->
            <div class="position-relative mb-3" style="max-width: 350px;">
                <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" id="menuSearchInput" class="form-control form-control-sm ps-5 rounded-pill shadow-sm border-warning" placeholder="Search menu or category..." />
            </div>

            <!-- CATEGORY FILTER PILLS -->
            <div class="d-flex flex-wrap gap-2 mb-4">
                <button type="button" class="btn btn-sm btn-outline-custom active category-btn rounded-pill px-3 py-2" data-filter="all">
                    <i class="fa-solid fa-utensils me-1"></i> All Items
                </button>
                @if (Model.PopularMenus.Any())
                {
                    <button type="button" class="btn btn-sm btn-outline-warning category-btn rounded-pill px-3 py-2 fw-bold" data-filter="popular">
                        <i class="fa-solid fa-fire me-1"></i> Popular / Favorites
                    </button>
                }
                @foreach (var cat in Model.Categories)
                {
                    <button type="button" class="btn btn-sm btn-outline-custom category-btn rounded-pill px-3 py-2" data-filter="@cat.ToLower()">
                        @cat
                    </button>
                }
            </div>

            <!-- POPULAR ITEMS HIGHLIGHT SECTION -->
            @if (Model.PopularMenus.Any())
            {
                <div class="mb-4 popular-section">
                    <h6 class="fw-bold text-muted mb-2"><i class="fa-solid fa-star text-warning me-1"></i> Frequently Ordered By You</h6>
                    <div class="d-flex gap-3 overflow-auto pb-2">
                        @foreach (var pop in Model.PopularMenus)
                        {
                            <div class="card border-0 shadow-sm rounded-4 p-2 bg-white" style="min-width: 180px;">
                                <img src="@(string.IsNullOrEmpty(pop.ImagePath) ? "https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=200&q=80" : pop.ImagePath)" 
                                     class="rounded-3 object-fit-cover mb-2" style="height: 110px; width: 100%;" />
                                <h6 class="fw-bold mb-0 text-truncate" style="font-size: 0.9rem;">@pop.MenuName</h6>
                                <span class="text-yellow-price fw-bold small">RM @pop.Price.ToString("N2")</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- FOOD ITEMS SECTION TITLE -->
            <div class="mb-3">
                <h4 class="fw-bold" style="color: var(--text-main);">Food Items</h4>
            </div>

            <!-- MENU GRID -->
            <div class="row g-3" id="menuGrid">
                @foreach (var menu in Model.Menus)
                {
                    string itemCat = string.IsNullOrWhiteSpace(menu.Category) ? "uncategorized" : menu.Category.ToLower();
                    bool isPopular = Model.PopularMenus.Any(p => p.Id == menu.Id);

                    <div class="col-md-4 menu-card-item" data-category="@itemCat" data-name="@menu.MenuName.ToLower()" data-popular="@(isPopular ? "true" : "false")">
                        <div class="card h-100 p-3 shadow-sm rounded-4 border-0 bg-white">
                            <div class="d-flex flex-column gap-2 mb-2">
                                <img src="@(string.IsNullOrEmpty(menu.ImagePath) ? "https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=300&q=80" : menu.ImagePath)" 
                                     alt="@menu.MenuName" class="rounded-3 object-fit-cover w-100" style="height: 150px;" />
                                <div>
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="fw-bold mb-1 text-dark" style="font-size: 0.95rem;">@menu.MenuName</h6>
                                        @if (isPopular)
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill"><i class="fa-solid fa-fire"></i></span>
                                        }
                                    </div>
                                    <p class="text-muted small mb-1 text-truncate">@menu.Description</p>
                                    <span class="fw-bold text-yellow-price" style="font-size: 0.95rem;">RM @menu.Price.ToString("N2")</span>
                                </div>
                            </div>

                            <form method="post" asp-page-handler="AddToCart" class="mt-auto pt-2 border-top">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="menuId" value="@menu.Id" />

                                <div class="d-flex align-items-center justify-content-between gap-1 mb-2">
                                    <div class="btn-group btn-group-sm flex-grow-1" role="group">
                                        <input type="radio" class="btn-check" name="size" id="sizeReg_@menu.Id" value="Regular" checked>
                                        <label class="btn btn-outline-secondary rounded-start-pill py-1 px-1 fw-bold" style="font-size: 0.75rem;" for="sizeReg_@menu.Id">S</label>

                                        <input type="radio" class="btn-check" name="size" id="sizeLg_@menu.Id" value="Large">
                                        <label class="btn btn-outline-secondary rounded-end-pill py-1 px-1 fw-bold" style="font-size: 0.75rem;" for="sizeLg_@menu.Id">L (+2)</label>
                                    </div>

                                    <div class="input-group input-group-sm" style="width: 90px;">
                                        <button type="button" class="btn btn-outline-secondary px-1 decrement-btn">-</button>
                                        <input type="number" name="quantity" value="1" min="1" class="form-control text-center qty-input p-1" readonly />
                                        <button type="button" class="btn btn-outline-secondary px-1 increment-btn">+</button>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-sm text-white w-100 rounded-3 fw-bold py-2 shadow-sm" style="background-color: #d97706 !important; border: none; font-size: 0.85rem;">
                                    <i class="fa-solid fa-cart-plus me-1"></i> Add to Cart
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT SIDEBAR: ORDER SUMMARY -->
        <div class="col-lg-4 pt-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 20px;">
                <h4 class="fw-bold mb-3" style="color: var(--text-main);">
                    <i class="fa-solid fa-receipt me-2" style="color: #d97706;"></i>Order Summary
                </h4>

                <!-- CART ITEMS LIST -->
                <div class="cart-items-scroll mb-3" style="max-height: 280px; overflow-y: auto;">
                    @if (!Model.CartItems.Any())
                    {
                        <div class="text-center py-4">
                            <i class="fa-solid fa-cart-shopping fa-2x text-muted opacity-50 mb-2"></i>
                            <p class="text-muted small mb-0">Your cart is empty. Add items from the menu.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <div>
                                    <h6 class="fw-bold mb-0" style="font-size: 0.9rem;">@item.MenuName</h6>
                                    <small class="text-muted">@item.Size | x@(item.Quantity)</small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold small">RM @((item.Price * item.Quantity).ToString("N2"))</span>
                                    <form method="post" asp-page-handler="RemoveCartItem" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm text-danger p-0 border-0 bg-transparent">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- PROMO / REWARD CODE INPUT SECTION -->
                <div class="mb-3 pt-2 border-top">
                    <label class="form-label small fw-bold"><i class="fa-solid fa-ticket text-warning me-1"></i> Reward Promo Code</label>
                    @if (string.IsNullOrEmpty(Model.AppliedPromoCode))
                    {
                        <form method="post" asp-page-handler="ApplyPromoCode" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="text" name="promoCode" class="form-control form-control-sm rounded-3" placeholder="Enter code (e.g. DRINK-123)" required />
                            <button type="submit" class="btn btn-warning btn-sm text-dark fw-bold rounded-3 px-3">Apply</button>
                        </form>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-between bg-light p-2 rounded-3 border">
                            <div>
                                <span class="badge bg-success me-1">Code Active</span>
                                <strong class="small">@Model.AppliedPromoCode</strong>
                            </div>
                            <form method="post" asp-page-handler="RemovePromoCode" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm text-danger p-0 border-0 bg-transparent" title="Remove Code">
                                    <i class="fa-solid fa-circle-xmark"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>

                <!-- SUBTOTAL, DISCOUNT & TOTAL -->
                <div class="border-top pt-3 mb-3">
                    <div class="d-flex justify-content-between text-muted small mb-1">
                        <span>Subtotal</span>
                        <span>RM @Model.Subtotal.ToString("N2")</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between text-success small mb-1 fw-bold">
                            <span>Reward Discount (@Model.DiscountDescription)</span>
                            <span>- RM @Model.DiscountAmount.ToString("N2")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>SST (6%)</span>
                        <span>RM @Model.Tax.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold fs-5" style="color: var(--text-main);">
                        <span>Total Amount</span>
                        <span class="text-yellow-price">RM @Model.Total.ToString("N2")</span>
                    </div>
                </div>

                <!-- ORDER CONFIRMATION FORM WITH PAX FILTERING -->
                <form method="get" id="paxFilterForm">
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Number of Pax (Guests)</label>
                        <input type="number" id="paxInput" name="pax" value="@Model.SelectedPax" min="1" max="20" class="form-control form-control-sm rounded-3" placeholder="Enter guests..." />
                    </div>
                </form>

                <form method="post" asp-page-handler="ConfirmOrder" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SelectedPax" value="@Model.SelectedPax" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Select Dine-In Table</label>
                        <select asp-for="TableId" asp-items="Model.Tables" class="form-select form-select-sm rounded-3" required>
                            <option value="">-- Choose Available Table --</option>
                        </select>
                    </div>

                    <button type="submit" class="btn text-white w-100 py-2 rounded-3 fw-bold shadow-sm" 
                            style="background-color: #d97706 !important; border: none;"
                            @(Model.CartItems.Any() ? "" : "disabled")>
                        Proceed to Payment <i class="fa-solid fa-arrow-right ms-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Handle + / - serving steppers
            document.querySelectorAll('.card').forEach(card => {
                const decBtn = card.querySelector('.decrement-btn');
                const incBtn = card.querySelector('.increment-btn');
                const qtyInput = card.querySelector('.qty-input');

                if (decBtn && incBtn && qtyInput) {
                    incBtn.addEventListener('click', () => {
                        let current = parseInt(qtyInput.value) || 1;
                        qtyInput.value = current + 1;
                    });

                    decBtn.addEventListener('click', () => {
                        let current = parseInt(qtyInput.value) || 1;
                        if (current > 1) {
                            qtyInput.value = current - 1;
                        }
                    });
                }
            });

            // 2. Category filtering & Search logic
            const filterButtons = document.querySelectorAll('.category-btn');
            const searchInput = document.getElementById('menuSearchInput');
            const menuCards = document.querySelectorAll('.menu-card-item');

            function filterMenu() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                const activeBtn = document.querySelector('.category-btn.active');
                const selectedFilter = activeBtn ? activeBtn.getAttribute('data-filter') : 'all';

                menuCards.forEach(card => {
                    const cardCat = card.getAttribute('data-category');
                    const cardName = card.getAttribute('data-name');
                    const isPopular = card.getAttribute('data-popular') === 'true';

                    const matchesSearch = cardName.includes(searchTerm) || cardCat.includes(searchTerm);
                    let matchesCategory = false;

                    if (selectedFilter === 'all') {
                        matchesCategory = true;
                    } else if (selectedFilter === 'popular') {
                        matchesCategory = isPopular;
                    } else {
                        matchesCategory = (cardCat === selectedFilter);
                    }

                    if (matchesSearch && matchesCategory) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            }

            filterButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    filterButtons.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    filterMenu();
                });
            });

            if (searchInput) {
                searchInput.addEventListener('input', filterMenu);
            }

            // 3. Auto-submit or reload tables when Pax changes
            const paxInput = document.getElementById('paxInput');
            if (paxInput) {
                let timeout = null;
                paxInput.addEventListener('input', function () {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => {
                        const paxVal = this.value || 1;
                        window.location.href = `?pax=${paxVal}`;
                    }, 600);
                });
            }
        });
    </script>
}