@page
@model RestaurantManagementSystem.Pages.Customer.DashboardModel

@{
    ViewData["Title"] = "Customer Dashboard";
    ViewData["ActivePage"] = "Home";
    ViewData["CustomerName"] = Model.CustomerName;
    Layout = "_CustomerLayout";
}
<div class="my-4">

    @if (TempData["ReservationSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <strong>Reservation successful!</strong> @TempData["ReservationSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Original Hero Banner Section -->
    <div class="hero-section mb-5">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="hero-title">Great Food &amp; <span>Table Reservations</span></h1>
                <p class="text-muted mt-3 mb-4">Discover your favorite meals, explore our menu, and secure your table instantly.</p>

                <div>
                    <a asp-page="/Customer/ReserveTable" class="btn btn-warning btn-lg fw-bold px-4 py-3 rounded-pill shadow-sm" style="background-color: var(--primary-color); color: #FFFFFF; border: none;">
                        <i class="fa-solid fa-chair me-2"></i> Make Reservation
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=500&auto=format&fit=crop&q=60" alt="Delicious Food" class="img-fluid rounded-circle shadow-lg" style="width: 320px; height: 320px; object-fit: cover; border: 8px solid #FFFFFF;">
            </div>
        </div>
    </div>

    <!-- Dynamic Popular Menu Items Section -->
    <div class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold m-0" style="color: var(--text-main);">Popular Menu Items</h3>
                <p class="text-muted small m-0">Customer favorites ranked by total orders</p>
            </div>
            <!-- Redirected to OrderPortal -->
            <a asp-page="/Customer/OrderPortal" class="text-decoration-none fw-bold" style="color: var(--primary-color); font-size: 14px;">
                View All Menu <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.PopularMenus != null && Model.PopularMenus.Any())
            {
                @foreach (var popItem in Model.PopularMenus)
                {
                    <div class="col-md-4">
                        <div class="data-card h-100 p-4 rounded-4 shadow-sm border-0 d-flex flex-column justify-content-between bg-white">
                            <div>
                                <div style="height: 180px; border-radius: 16px; overflow: hidden; background-color: #FFF9F0;" class="mb-3">
                                    <img src="@(!string.IsNullOrEmpty(popItem.ImagePath) ? popItem.ImagePath : "https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=500")" alt="@popItem.MenuName" style="width: 100%; height: 100%; object-fit: cover;" />
                                </div>
                                <span class="badge bg-light text-dark mb-2 px-2.5 py-1 rounded-pill" style="font-size: 11px;">@popItem.Category</span>
                                <h4 class="fw-bold mb-1" style="color: var(--text-main);">@popItem.MenuName</h4>
                                <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@popItem.Description</p>
                            </div>
                            <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                                <span class="fw-bold fs-5" style="color: var(--primary-color);">RM @popItem.Price.ToString("N2")</span>
                                <!-- Redirected to OrderPortal -->
                                <a asp-page="/Customer/OrderPortal" class="btn btn-sm rounded-pill px-4 text-white fw-bold" style="background-color: var(--primary-color);">
                                    Order Now
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Fallback Cards in case Database has no orders yet -->
                <div class="col-md-4">
                    <div class="data-card h-100 p-4 rounded-4 shadow-sm border-0 bg-white">
                        <div style="height: 180px; border-radius: 16px; overflow: hidden;" class="mb-3">
                            <img src="https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=500&auto=format&fit=crop&q=60" alt="Pastry" class="w-100 h-100 object-fit-cover" />
                        </div>
                        <span class="badge bg-light text-dark mb-2">Dessert</span>
                        <h4 class="fw-bold mb-1">Aatis Pastry</h4>
                        <p class="text-muted small mb-3">Layered chocolate and cream mousse cake.</p>
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                            <span class="fw-bold fs-5" style="color: var(--primary-color);">RM 15.00</span>
                            <a asp-page="/Customer/OrderPortal" class="btn btn-sm rounded-pill px-4 text-white fw-bold" style="background-color: var(--primary-color);">Order Now</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="data-card h-100 p-4 rounded-4 shadow-sm border-0 bg-white">
                        <div style="height: 180px; border-radius: 16px; overflow: hidden;" class="mb-3">
                            <img src="https://images.unsplash.com/photo-1509440159596-0249088772ff?w=500&auto=format&fit=crop&q=60" alt="Cake" class="w-100 h-100 object-fit-cover" />
                        </div>
                        <span class="badge bg-light text-dark mb-2">Dessert</span>
                        <h4 class="fw-bold mb-1">Lermi Cake</h4>
                        <p class="text-muted small mb-3">Rich dark chocolate square with vanilla cream.</p>
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                            <span class="fw-bold fs-5" style="color: var(--primary-color);">RM 18.00</span>
                            <a asp-page="/Customer/OrderPortal" class="btn btn-sm rounded-pill px-4 text-white fw-bold" style="background-color: var(--primary-color);">Order Now</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="data-card h-100 p-4 rounded-4 shadow-sm border-0 bg-white">
                        <div style="height: 180px; border-radius: 16px; overflow: hidden;" class="mb-3">
                            <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=500&auto=format&fit=crop&q=60" alt="Flitre" class="w-100 h-100 object-fit-cover" />
                        </div>
                        <span class="badge bg-light text-dark mb-2">Dessert</span>
                        <h4 class="fw-bold mb-1">Flitre Special</h4>
                        <p class="text-muted small mb-3">Signature hazelnut praline sponge slice.</p>
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                            <span class="fw-bold fs-5" style="color: var(--primary-color);">RM 20.00</span>
                            <a asp-page="/Customer/OrderPortal" class="btn btn-sm rounded-pill px-4 text-white fw-bold" style="background-color: var(--primary-color);">Order Now</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>