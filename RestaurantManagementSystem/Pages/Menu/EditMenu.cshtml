@page
@model RestaurantManagementSystem.Pages.Menu.EditMenuModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Menu";
    ViewData["ActiveNav"] = "Menu";
}

@section Styles {
    <link rel="stylesheet" href="~/MenuPages.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h2 class="page-title">Edit Menu</h2>
        <p class="text-muted mb-0">Update the dish details below.</p>
    </div>
    <a asp-page="/Admin/ManageMenu" class="btn btn-back">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Menu
    </a>
</div>

<div class="form-card">
    <form method="post" enctype="multipart/form-data">

        <input type="hidden" asp-for="Menu.Id" />
        <input type="hidden" asp-for="Menu.ImagePath" />

        <div asp-validation-summary="ModelOnly" class="field-error mb-3"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Menu.MenuName" class="form-label"></label>
                <input asp-for="Menu.MenuName" class="form-control" />
                <span asp-validation-for="Menu.MenuName" class="field-error"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Menu.Category" class="form-label"></label>
                <select asp-for="Menu.Category" class="form-select">
                    <option value="">-- Select Category --</option>
                    <option value="Burgers">Burgers</option>
                    <option value="Pizza">Pizza</option>
                    <option value="Sushi">Sushi</option>
                    <option value="Salads">Salads</option>
                    <option value="Desserts">Desserts</option>
                    <option value="Drinks">Drinks</option>
                </select>
                <span asp-validation-for="Menu.Category" class="field-error"></span>
            </div>

            <div class="col-12">
                <label asp-for="Menu.Description" class="form-label"></label>
                <textarea asp-for="Menu.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Menu.Description" class="field-error"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Menu.Price" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">RM</span>
                    <input asp-for="Menu.Price" type="number" step="0.01" min="0.01" class="form-control" />
                </div>
                <span asp-validation-for="Menu.Price" class="field-error"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="ImageFile" class="form-label">Replace Image (optional)</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" id="imageInput" />
                <span asp-validation-for="ImageFile" class="field-error"></span>
            </div>

            <div class="col-12">
                <label class="form-label d-block">Image</label>
                @if (!string.IsNullOrEmpty(Model.Menu.ImagePath))
                {
                    <img id="imagePreview" src="@Model.Menu.ImagePath" class="image-preview" alt="@Model.Menu.MenuName" />
                }
                else
                {
                    <img id="imagePreview" class="image-preview d-none" alt="Image preview" />
                }
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-orange">
                <i class="fa-solid fa-check me-2"></i> Update Menu
            </button>
            <a asp-page="/Admin/ManageMenu" class="btn btn-back">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('imageInput').addEventListener('change', function(e) {
            var file = e.target.files[0];
            var preview = document.getElementById('imagePreview');
            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.classList.remove('d-none');
            }
        });
    </script>
}
