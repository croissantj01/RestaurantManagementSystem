@page
@model RestaurantManagementSystem.Pages.Menu.EditMenuModel

@{
    ViewData["Title"] = "Edit Menu";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Edit Menu</h2>

        <a asp-page="/Admin/Dashboard"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    <div class="card">
        <div class="card-body">

            <form method="post"
                  enctype="multipart/form-data">

                <input type="hidden"
                       asp-for="Menu.Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- Menu Name -->
                <div class="mb-3">
                    <label asp-for="Menu.MenuName"
                           class="form-label">
                    </label>

                    <input asp-for="Menu.MenuName"
                           class="form-control" />

                    <span asp-validation-for="Menu.MenuName"
                          class="text-danger">
                    </span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Menu.Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Menu.Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Menu.Description"
                          class="text-danger">
                    </span>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label asp-for="Menu.Price"
                           class="form-label">
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">RM</span>

                        <input asp-for="Menu.Price"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />
                    </div>

                    <span asp-validation-for="Menu.Price"
                          class="text-danger">
                    </span>
                </div>

                <!-- Current Image -->
                <div class="mb-3">
                    <label class="form-label">
                        Current Image
                    </label>

                    @if (!string.IsNullOrEmpty(Model.Menu.ImagePath))
                    {
                        <div>
                            <img src="@Model.Menu.ImagePath"
                                 alt="@Model.Menu.MenuName"
                                 style="width:150px;
                            height:120px;
                            object-fit:cover;"
                                 class="rounded border" />
                        </div>
                    }
                </div>

                <!-- New Image -->
                <div class="mb-3">
                    <label asp-for="ImageFile"
                           class="form-label">
                        Replace Image
                    </label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                    <span asp-validation-for="ImageFile"
                          class="text-danger">
                    </span>

                    <small class="text-muted">
                        Leave empty if you want to keep the current image.
                    </small>
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Save Changes
                </button>

                <a asp-page="/Admin/Dashboard"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>