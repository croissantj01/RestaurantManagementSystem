@page
@model RestaurantManagementSystem.Pages.Menu.DeleteMenuModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Menu";
    ViewData["ActiveNav"] = "Menu";
}

@section Styles {
    <link rel="stylesheet" href="~/MenuPages.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h2 class="page-title">Delete Menu</h2>
        <p class="text-muted mb-0">Review the dish before removing it.</p>
    </div>
    <a asp-page="/Admin/ManageMenu" class="btn btn-back">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Menu
    </a>
</div>

<div class="delete-warning">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span>Are you sure you want to delete this menu? This cannot be undone.</span>
</div>

<div class="form-card">
    <div class="row g-4 align-items-center">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.Menu.ImagePath))
            {
                <img src="@Model.Menu.ImagePath" alt="@Model.Menu.MenuName" class="image-preview w-100" />
            }
            else
            {
                <div class="image-preview image-empty w-100"><i class="fa-solid fa-image"></i></div>
            }
        </div>

        <div class="col-md-8">
            <span class="area-chip mb-2">@Model.Menu.Category</span>
            <h4 class="fw-bold">@Model.Menu.MenuName</h4>
            <p class="text-muted">@Model.Menu.Description</p>
            <div class="menu-price">RM @Model.Menu.Price.ToString("0.00")</div>
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Menu.Id" />

        <div class="form-actions">
            <button type="submit" class="btn btn-danger-solid">
                <i class="fa-solid fa-trash me-2"></i> Yes, Delete
            </button>
            <a asp-page="/Admin/ManageMenu" class="btn btn-back">Cancel</a>
        </div>
    </form>
</div>

