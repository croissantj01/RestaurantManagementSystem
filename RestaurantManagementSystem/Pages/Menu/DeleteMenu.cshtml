@page
@model RestaurantManagementSystem.Pages.Menu.DeleteMenuModel

@{
    ViewData["Title"] = "Delete Menu";
}

<div class="container mt-4">

    <h2>Delete Menu</h2>

    <div class="alert alert-danger mt-3">
        <strong>Are you sure you want to delete this menu?</strong>
    </div>

    <div class="card">
        <div class="card-body">

            <div class="row">

                <div class="col-md-3">

                    @if (!string.IsNullOrEmpty(Model.Menu.ImagePath))
                    {
                        <img src="@Model.Menu.ImagePath"
                             alt="@Model.Menu.MenuName"
                             class="img-fluid rounded"
                             style="max-height:200px;
                        object-fit:cover;" />
                    }

                </div>

                <div class="col-md-9">

                    <h4>@Model.Menu.MenuName</h4>

                    <p>
                        @Model.Menu.Description
                    </p>

                    <p>
                        <strong>
                            Price:
                        </strong>

                        RM @Model.Menu.Price.ToString("0.00")
                    </p>

                </div>

            </div>

            <hr />

            <form method="post">

                <input type="hidden"
                       asp-for="Menu.Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete
                </button>

                <a asp-page="/Admin/Dashboard"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>