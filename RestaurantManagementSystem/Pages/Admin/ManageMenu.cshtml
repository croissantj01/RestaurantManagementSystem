@page
@model RestaurantManagementSystem.Pages.Admin.ManageMenuModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Menu";
    ViewData["ActiveNav"] = "Menu";

    // Supports both the page model's StatusMessage and the "SuccessMessage" key
    // set by the Add / Edit / Delete pages.
    var successMessage = Model.StatusMessage ?? TempData["SuccessMessage"] as string;
    bool isFiltering = !string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.CategoryFilter);
}

@section Styles {
    <link rel="stylesheet" href="~/MenuPages.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h2 class="page-title">Manage Menu</h2>
        <p class="text-muted mb-0">Add, edit or remove dishes on your restaurant menu.</p>
    </div>
    <a asp-page="/Menu/AddMenu" class="btn btn-orange">
        <i class="fa-solid fa-plus me-2"></i> Add Menu
    </a>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-1"></i> @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search + Category Filter -->
<form method="get" class="filter-bar">
    <div class="filter-search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" name="SearchTerm" value="@Model.SearchTerm"
               class="form-control" placeholder="Search by menu name..." />
    </div>

    <select name="CategoryFilter" class="form-select filter-select" onchange="this.form.submit()">
        <option value="">All Categories</option>
        @foreach (var c in Model.Categories)
        {
            <option value="@c" selected="@(c == Model.CategoryFilter)">@c</option>
        }
    </select>

    <button type="submit" class="btn btn-orange">Search</button>

    @if (isFiltering)
    {
        <a asp-page="/Admin/ManageMenu" class="btn-back">Clear</a>
    }
</form>

<div class="panel-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="panel-title"><i class="fa-solid fa-burger me-2 icon-accent"></i>All Menu Items</h5>
        <span class="count-pill">
            @if (Model.MenuList.Count != Model.TotalCount)
            {
                @:@Model.MenuList.Count of @Model.TotalCount shown
            }
            else
            {
                @:@Model.TotalCount total
            }
        </span>
    </div>

    @if (Model.MenuList.Count == 0)
    {
        <div class="empty-state">
            <i class="fa-solid fa-bowl-food"></i>
            @if (Model.TotalCount == 0)
            {
                @:No menu items yet. Click Add Menu to create one.
            }
            else
            {
                @:No menu items match your search or filter.
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Menu Name</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.MenuList)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="@item.MenuName" class="menu-thumb" />
                                }
                                else
                                {
                                    <div class="menu-thumb menu-thumb-empty"><i class="fa-solid fa-image"></i></div>
                                }
                            </td>
                            <td><strong>@item.MenuName</strong></td>
                            <td><span class="area-chip">@item.Category</span></td>
                            <td class="text-muted small cell-desc">@item.Description</td>
                            <td class="text-nowrap">RM @item.Price.ToString("0.00")</td>
                            <td class="text-end text-nowrap">
                                <a asp-page="/Menu/EditMenu" asp-route-id="@item.Id" class="btn btn-sm btn-edit">
                                    <i class="fa-solid fa-pen me-1"></i> Edit
                                </a>
                                <a asp-page="/Menu/DeleteMenu" asp-route-id="@item.Id" class="btn btn-sm btn-delete">
                                    <i class="fa-solid fa-trash me-1"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
