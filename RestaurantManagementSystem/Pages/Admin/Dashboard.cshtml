@page
@model RestaurantManagementSystem.Pages.Admin.DashboardModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
    ViewData["ActiveNav"] = "Dashboard";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 mt-4 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hero Section -->
<div class="admin-hero">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="hero-title">Restaurant <span>Admin Panel</span></h1>

            <p class="text-muted mt-3 mb-4">
                Manage your staff accounts, restaurant tables, menu items, and review restaurant performance in one place.
            </p>

            <div>
                <a asp-page="/Admin/ManageMenu" class="btn btn-orange btn-lg px-4 py-3">
                    <i class="fa-solid fa-utensils me-2"></i> Manage Menu
                </a>
            </div>
        </div>

        <div class="col-lg-4 d-none d-lg-block text-center">
            <div class="hero-icon">
                <img src="~/images/restaurant2.jpg"
                     alt="Restaurant 2"
                     class="admin-hero-image" />
            </div>
        </div>
    </div>
</div>

<!-- Summary Stats -->
<div class="mb-5">
    <h3 class="fw-bold mb-4">Overview</h3>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: #FFF3E0; color: #E67E22;">
                    <i class="fa-solid fa-bell-concierge"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.TodayOrders</div>
                    <div class="stat-label">Today's Orders</div>

                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: #FFF3E0; color: #E67E22;">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.TodayReservations</div>
                    <div class="stat-label">Today's Reservations</div>
                   
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: #FFF3E0; color: #E67E22;">
                    <i class="fa-solid fa-chair"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.ReservedTables/@Model.TotalTables</div>
                    <div class="stat-label">Reserved Tables</div>
                    <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 2px;">Tables with a reservation today</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: #FFF3E0; color: #E67E22;">
                    <i class="fa-solid fa-address-book"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.CustomerCount</div>
                    <div class="stat-label">Registered Customers</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: #FFF3E0; color: #E67E22;">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.StaffCount</div>
                    <div class="stat-label">Staff Accounts</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: #FFF3E0; color: #E67E22;">
                    <i class="fa-solid fa-burger"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.MenuCount</div>
                    <div class="stat-label">Menu Items</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Admin Quick Actions -->
<div class="mb-5">
    <h3 class="fw-bold mb-4">Admin Quick Actions</h3>

    <div class="row g-4">

        <!-- First Row: 3 Cards -->

        <div class="col-12 col-md-6 col-lg-4">
            <div class="promo-action-card" style="--accent: #2980B9;">
                <div>
                    <div class="action-icon" style="background: #EBF5FB; color: #2980B9;">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>
                    <h4 class="fw-bold">Manage Staffs</h4>
                    <p class="text-muted small">Create, update, or remove staff accounts.</p>
                </div>
                <a asp-page="/Admin/ManageStaff/ManageStaff" class="btn btn-action">
                    Manage Staffs
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="promo-action-card" style="--accent: #16A085;">
                <div>
                    <div class="action-icon" style="background: #E8F8F5; color: #16A085;">
                        <i class="fa-solid fa-utensils"></i>
                    </div>
                    <h4 class="fw-bold">Manage Menu</h4>
                    <p class="text-muted small">Add new dishes, edit prices, and update item details.</p>
                </div>
                <a asp-page="/Admin/ManageMenu" class="btn btn-action">
                    Manage Menu
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="promo-action-card" style="--accent: #cf2b0a;">
                <div>
                    <div class="action-icon" style="background: #f5c4c4; color: #cf2b0a;">
                        <i class="fa-solid fa-chair"></i>
                    </div>
                    <h4 class="fw-bold">Manage Restaurant Tables</h4>
                    <p class="text-muted small">Add new tables, delete or edit restaurant tables.</p>
                </div>
                <a asp-page="/Admin/RestaurantTables/Index" class="btn btn-action">
                    Manage Restaurant Tables
                </a>
            </div>
        </div>

        <!-- Second Row: 3 Cards -->

        <div class="col-12 col-md-6 col-lg-4">
            <div class="promo-action-card" style="--accent: #7E22CE;">
                <div>
                    <div class="action-icon" style="background: #F3E8FF; color: #7E22CE;">
                        <i class="fa-solid fa-address-book"></i>
                    </div>
                    <h4 class="fw-bold">Customers</h4>
                    <p class="text-muted small">View customer details, their orders and reservations.</p>
                </div>
                <a asp-page="/Admin/ManageCustomer" class="btn btn-action">
                    View Customers
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="promo-action-card" style="--accent: #E67E22;">
                <div>
                    <div class="action-icon" style="background: #FFF3E0; color: #E67E22;">
                        <i class="fa-solid fa-bullhorn"></i>
                    </div>
                    <h4 class="fw-bold">Announcements</h4>
                    <p class="text-muted small">Post news and notices for your customers and staff.</p>
                </div>
                <a asp-page="/Admin/Announcements" class="btn btn-action">
                    Announcements
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="promo-action-card" style="--accent: #e72aeb;">
                <div>
                    <div class="action-icon" style="background: #f4c4f5; color: #e72aeb;">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <h4 class="fw-bold">View Report</h4>
                    <p class="text-muted small">Review orders, reservations, and revenue for a chosen period.</p>
                </div>
                <a asp-page="/Admin/Reports/Index" class="btn btn-action">
                    View Report
                </a>
            </div>
        </div>

    </div>
</div>