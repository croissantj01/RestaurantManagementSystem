@page "{id:int}"
@model RestaurantManagementSystem.Pages.Admin.RestaurantTables.DeleteModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Restaurant Table";
    ViewData["ActiveNav"] = "Tables";
}

@section Styles {
    <link rel="stylesheet" href="~/RestaurantTables.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h2 class="page-title">Delete Restaurant Table</h2>
        <p class="text-muted mb-0">Review the table details before removing it.</p>
    </div>
    <a asp-page="Index" class="btn btn-back">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to Tables
    </a>
</div>

<div class="delete-warning">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span>Are you sure you want to delete this restaurant table? This cannot be undone.</span>
</div>

<div class="form-card">
    <dl class="detail-list">
        <div class="detail-row">
            <dt>Table Number</dt>
            <dd><strong>@Model.RestaurantTable.TableNumber</strong></dd>
        </div>
        <div class="detail-row">
            <dt>Dining Area</dt>
            <dd><span class="area-chip">@Model.RestaurantTable.DiningArea</span></dd>
        </div>
        <div class="detail-row">
            <dt>Capacity</dt>
            <dd>@Model.RestaurantTable.Capacity</dd>
        </div>
        <div class="detail-row">
            <dt>Status</dt>
            <dd><span class="status-badge status-@(Model.RestaurantTable.Status?.ToLower())">@Model.RestaurantTable.Status</span></dd>
        </div>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="RestaurantTable.RestaurantTableId" />

        <div class="form-actions">
            <button type="submit" class="btn btn-danger-solid">
                <i class="fa-solid fa-trash me-2"></i> Yes, Delete
            </button>
            <a asp-page="Index" class="btn btn-back">Cancel</a>
        </div>
    </form>
</div>
