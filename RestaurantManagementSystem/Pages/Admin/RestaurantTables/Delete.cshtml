@page "{id:int}"
@model RestaurantManagementSystem.Pages.Admin.RestaurantTables.DeleteModel

@{
    ViewData["Title"] = "Delete Restaurant Table";
}

<div class="container mt-4">

    <h2>Delete Restaurant Table</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this restaurant table?
    </div>

    <div class="card">
        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Table Number
                </dt>
                <dd class="col-sm-9">
                    @Model.RestaurantTable.TableNumber
                </dd>

                <dt class="col-sm-3">
                    Dining Area
                </dt>
                <dd class="col-sm-9">
                    @Model.RestaurantTable.DiningArea
                </dd>

                <dt class="col-sm-3">
                    Capacity
                </dt>
                <dd class="col-sm-9">
                    @Model.RestaurantTable.Capacity
                </dd>

                <dt class="col-sm-3">
                    Status
                </dt>
                <dd class="col-sm-9">
                    @Model.RestaurantTable.Status
                </dd>

            </dl>

            <form method="post">

                <input type="hidden"
                       asp-for="RestaurantTable.RestaurantTableId" />

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete
                </button>

                <a asp-page="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>