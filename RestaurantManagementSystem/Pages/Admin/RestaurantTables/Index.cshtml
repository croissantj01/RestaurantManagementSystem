@page
@model RestaurantManagementSystem.Pages.Admin.RestaurantTables.IndexModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Restaurant Tables";
    ViewData["ActiveNav"] = "Tables";

    bool isFiltering = !string.IsNullOrWhiteSpace(Model.AreaFilter);
}

@section Styles {
    <link rel="stylesheet" href="~/RestaurantTables.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h2 class="page-title">Manage Restaurant Tables</h2>
        <p class="text-muted mb-0">Manage dining areas, tables, capacity and availability.</p>
    </div>
    <a asp-page="Create" class="btn btn-orange">
        <i class="fa-solid fa-plus me-2"></i> Add Table
    </a>
</div>

<!-- Filter by Dining Area -->
<form method="get" class="filter-bar">
    <select name="AreaFilter" class="form-select filter-select" onchange="this.form.submit()">
        <option value="">All Dining Areas</option>
        @foreach (var area in Model.DiningAreas)
        {
            <option value="@area" selected="@(area == Model.AreaFilter)">@area</option>
        }
    </select>

    @if (isFiltering)
    {
        <a asp-page="Index" class="btn-back">Clear</a>
    }
</form>

<div class="panel-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="panel-title"><i class="fa-solid fa-chair me-2 icon-accent"></i>All Tables</h5>
        <span class="count-pill">
            @if (Model.RestaurantTables.Count != Model.TotalCount)
            {
                @:@Model.RestaurantTables.Count of @Model.TotalCount shown
            }
            else
            {
                @:@Model.TotalCount total
            }
        </span>
    </div>

    @if (Model.RestaurantTables.Count == 0)
    {
        <div class="empty-state">
            <i class="fa-solid fa-chair"></i>
            @if (Model.TotalCount == 0)
            {
                @:No restaurant tables have been added yet.
            }
            else
            {
                @:No tables found in this dining area.
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Table Number</th>
                        <th>Dining Area</th>
                        <th>Capacity</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var table in Model.RestaurantTables)
                    {
                        <tr>
                            <td><strong>@table.TableNumber</strong></td>
                            <td><span class="area-chip">@table.DiningArea</span></td>
                            <td><i class="fa-solid fa-user-group me-1 text-muted"></i> @table.Capacity</td>
                            <td><span class="status-badge status-@(table.Status?.ToLower())">@table.Status</span></td>
                            <td class="text-end">
                                <a asp-page="Edit" asp-route-id="@table.RestaurantTableId" class="btn btn-sm btn-edit">
                                    <i class="fa-solid fa-pen me-1"></i> Edit
                                </a>
                                <a asp-page="Delete" asp-route-id="@table.RestaurantTableId" class="btn btn-sm btn-delete">
                                    <i class="fa-solid fa-trash me-1"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
