@page
@model RestaurantManagementSystem.Pages.Admin.RestaurantTables.CreateModel

@{
    ViewData["Title"] = "Add Restaurant Table";
}

<div class="container mt-4">

    <h2>Add Restaurant Table</h2>

    <form method="post">

        <div class="mb-3">
            <label asp-for="RestaurantTable.TableNumber"
                   class="form-label">
                Table Number
            </label>

            <input asp-for="RestaurantTable.TableNumber"
                   class="form-control"
                   placeholder="e.g. T01" />

            <span asp-validation-for="RestaurantTable.TableNumber"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RestaurantTable.DiningArea"
                   class="form-label">
                Dining Area
            </label>

            <select asp-for="RestaurantTable.DiningArea"
                    class="form-select">

                <option value="">-- Select Dining Area --</option>
                <option value="Indoor">Indoor</option>
                <option value="Outdoor">Outdoor</option>
                <option value="VIP Room">VIP Room</option>

            </select>

            <span asp-validation-for="RestaurantTable.DiningArea"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RestaurantTable.Capacity"
                   class="form-label">
                Capacity
            </label>

            <input asp-for="RestaurantTable.Capacity"
                   type="number"
                   class="form-control"
                   min="1"
                   max="20" />

            <span asp-validation-for="RestaurantTable.Capacity"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RestaurantTable.Status"
                   class="form-label">
                Status
            </label>

            <select asp-for="RestaurantTable.Status"
                    class="form-select">

                <option value="Available">Available</option>
                <option value="Reserved">Reserved</option>
                <option value="Occupied">Occupied</option>
                <option value="Unavailable">Unavailable</option>

            </select>

            <span asp-validation-for="RestaurantTable.Status"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Table
        </button>

        <a asp-page="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>