@page
@model RestaurantManagementSystem.Pages.Admin.ManageCustomerModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Customer Information";
    ViewData["ActiveNav"] = "ManageCustomer";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h3 class="fw-bold mb-0">Customer Information</h3>
    <a asp-page="/Admin/Dashboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

<div class="panel-card mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <h5 class="panel-title mb-0"><i class="fa-solid fa-users me-2 icon-accent"></i>Customers</h5>

        <div class="d-flex align-items-center gap-2">
            <span class="count-pill">@Model.Rows.Count total</span>
            <form method="get" class="d-flex gap-2">
                <input type="text" name="Q" value="@Model.Q" class="form-control form-control-sm" placeholder="Search name or email" />
                <button type="submit" class="btn btn-sm btn-orange px-3"><i class="fa-solid fa-magnifying-glass"></i></button>
                @if (!string.IsNullOrWhiteSpace(Model.Q))
                {
                    <a asp-page="/Admin/ManageCustomer" class="btn btn-sm btn-outline-secondary">Clear</a>
                }
            </form>
        </div>
    </div>

    @if (Model.Rows.Any())
    {
        <div class="table-scroll">
            <table class="table admin-table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th class="text-center">Orders</th>
                        <th class="text-center">Reservations</th>
                        <th class="text-end">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var c = row.Customer;
                        <tr>
                            <td><strong>@c.FullName</strong></td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td class="text-center"><span class="count-pill">@row.Orders.Count</span></td>
                            <td class="text-center"><span class="count-pill">@row.Reservations.Count</span></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-edit" data-bs-toggle="collapse" data-bs-target="#cust-@c.CustomerId">
                                    <i class="fa-solid fa-eye me-1"></i> View
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" class="p-0 border-0">
                                <div class="collapse" id="cust-@c.CustomerId">
                                    <div class="p-3 m-2 rounded-4" style="background:#FFF9F0;">

                                        <h6 class="fw-bold mb-2"><i class="fa-solid fa-receipt me-2 icon-accent"></i>Orders</h6>
                                        @if (row.Orders.Any())
                                        {
                                            <div class="table-scroll mb-4">
                                                <table class="table admin-table mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>Ordered</th>
                                                            <th>Dine-in</th>
                                                            <th>Table</th>
                                                            <th>Items</th>
                                                            <th>Total</th>
                                                            <th>Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var o in row.Orders)
                                                        {
                                                            var items = string.Join(", ", o.OrderItems.Select(i => (i.Menu?.MenuName ?? "Item") + " x" + i.Quantity));
                                                            <tr>
                                                                <td>@o.OrderId</td>
                                                                <td class="text-nowrap">@o.OrderDate.ToString("dd MMM yyyy, h:mm tt")</td>
                                                                <td class="text-nowrap">@o.DineInDateTime.ToString("dd MMM yyyy, h:mm tt")</td>
                                                                <td>@(o.Table?.TableNumber ?? "-")</td>
                                                                <td>@items</td>
                                                                <td class="text-nowrap">RM @o.TotalAmount.ToString("0.00")</td>
                                                                <td><span class="area-chip">@o.Status</span></td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-4">No orders yet.</p>
                                        }

                                        <h6 class="fw-bold mb-2"><i class="fa-solid fa-chair me-2 icon-accent"></i>Reservations</h6>
                                        @if (row.Reservations.Any())
                                        {
                                            <div class="table-scroll">
                                                <table class="table admin-table mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>Date</th>
                                                            <th>Time</th>
                                                            <th>Table</th>
                                                            <th>Area</th>
                                                            <th>Guests</th>
                                                            <th>Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var r in row.Reservations)
                                                        {
                                                            var time = DateTime.Today.Add(r.ReservationTime).ToString("h:mm tt");
                                                            <tr>
                                                                <td class="text-nowrap">@r.ReservationDate.ToString("dd MMM yyyy")</td>
                                                                <td>@time</td>
                                                                <td><strong>@r.RestaurantTable.TableNumber</strong></td>
                                                                <td>@r.RestaurantTable.DiningArea</td>
                                                                <td>@r.NumberOfGuests</td>
                                                                <td><span class="area-chip">@r.Status</span></td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-0">No reservations yet.</p>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-user-slash"></i>
            @(string.IsNullOrWhiteSpace(Model.Q) ? "No customers have registered yet." : "No customers match your search.")
        </div>
    }
</div>
