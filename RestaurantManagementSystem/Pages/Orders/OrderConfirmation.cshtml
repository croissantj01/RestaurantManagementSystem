@page
@model RestaurantManagementSystem.Pages.Orders.OrderConfirmationModel

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow">

                <!-- ================================= -->
                <!-- HEADER -->
                <!-- ================================= -->

                <div class="card-header bg-success text-white text-center">

                    <h3 class="mb-0">
                        Order Confirmed
                    </h3>

                </div>


                <div class="card-body">

                    <!-- ================================= -->
                    <!-- SUCCESS MESSAGE -->
                    <!-- ================================= -->

                    <div class="text-center mb-4">

                        <h4>
                            Thank you for your order!
                        </h4>

                        <p class="text-muted">
                            Your order has been successfully placed.
                        </p>

                    </div>


                    <!-- ================================= -->
                    <!-- ORDER INFORMATION -->
                    <!-- ================================= -->

                    <div class="row mb-4">

                        <div class="col-md-6">

                            <strong>
                                Order ID:
                            </strong>

                            <br />

                            #@Model.Order!.OrderId

                        </div>


                        <div class="col-md-6">

                            <strong>
                                Order Status:
                            </strong>

                            <br />

                            @if (Model.Order.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                            else if (Model.Order.Status == "Completed")
                            {
                                <span class="badge bg-success">
                                    Completed
                                </span>
                            }
                            else if (Model.Order.Status == "Cancelled")
                            {
                                <span class="badge bg-danger">
                                    Cancelled
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @Model.Order.Status
                                </span>
                            }

                        </div>

                    </div>


                    <!-- ================================= -->
                    <!-- DINE-IN INFORMATION -->
                    <!-- ================================= -->

                    <div class="mb-4">

                        <h5>
                            Dine-In Information
                        </h5>

                        <hr />


                        <!-- TABLE -->

                        <p class="mb-1">

                            <strong>
                                Table:
                            </strong>

                            @if (Model.Order.Table != null)
                            {
                                @Model.Order.Table.TableNumber
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not available
                                </span>
                            }

                        </p>


                        <!-- DINING AREA -->

                        <p class="mb-1">

                            <strong>
                                Dining Area:
                            </strong>

                            @if (Model.Order.Table != null)
                            {
                                @Model.Order.Table.DiningArea
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not available
                                </span>
                            }

                        </p>


                        <!-- DATE -->

                        <p class="mb-1">

                            <strong>
                                Date:
                            </strong>

                            @Model.Order.DineInDateTime.ToString("dd/MM/yyyy")

                        </p>


                        <!-- TIME -->

                        <p class="mb-1">

                            <strong>
                                Time:
                            </strong>

                            @Model.Order.DineInDateTime.ToString("hh:mm tt")

                        </p>

                    </div>


                    <!-- ================================= -->
                    <!-- ORDERED FOOD -->
                    <!-- ================================= -->

                    <div class="mb-4">

                        <h5>
                            Ordered Food
                        </h5>

                        <hr />


                        <div class="table-responsive">

                            <table class="table table-bordered">

                                <thead class="table-light">

                                    <tr>

                                        <th>
                                            Food
                                        </th>

                                        <th>
                                            Quantity
                                        </th>

                                        <th>
                                            Price
                                        </th>

                                        <th>
                                            Subtotal
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @if (Model.Order.OrderItems != null &&
                                         Model.Order.OrderItems.Count > 0)
                                    {
                                        @foreach (var item in Model.Order.OrderItems)
                                        {
                                            <tr>

                                                <!-- FOOD -->

                                                <td>

                                                    @(item.Menu?.MenuName
                                                        ?? "Unknown Item")

                                                </td>


                                                <!-- QUANTITY -->

                                                <td>

                                                    @item.Quantity

                                                </td>


                                                <!-- PRICE -->

                                                <td>

                                                    RM @item.Price.ToString("0.00")

                                                </td>


                                                <!-- SUBTOTAL -->

                                                <td>

                                                    RM @item.Subtotal.ToString("0.00")

                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>

                                            <td colspan="4"
                                                class="text-center text-muted">

                                                No food items found.

                                            </td>

                                        </tr>
                                    }

                                </tbody>


                                <!-- ================================= -->
                                <!-- TOTAL -->
                                <!-- ================================= -->

                                <tfoot>

                                    <tr>

                                        <th colspan="3"
                                            class="text-end">

                                            Total:

                                        </th>

                                        <th>

                                            RM @Model.Order.TotalAmount.ToString("0.00")

                                        </th>

                                    </tr>

                                </tfoot>

                            </table>

                        </div>

                    </div>


                    <!-- ================================= -->
                    <!-- BACK BUTTON -->
                    <!-- ================================= -->

                    <div class="text-center mt-4">

                        <a asp-page="/Orders/Index"
                           class="btn btn-primary">

                            Back to Orders

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>