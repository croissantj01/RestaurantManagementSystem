@page
@model RestaurantManagementSystem.Pages.IndexModel
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Welcome to MyCafe";
}

<!-- ===== Hero ===== -->
<header class="hero" id="home">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="container position-relative">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6">
                <span class="hero-tag">Fast. Delicious. Enjoyable.</span>
                <h1 class="hero-heading">MyCafe Food Ordering &amp; <span>Table Reservations</span></h1>
                <p class="hero-text">
                    Discover your favourite dishes, book a table and enjoy a smooth dining experience
                    at MyCafe.
                </p>
                <ul class="hero-points">
                    <li><i class="fa-solid fa-chair"></i><span><strong>Reserve a table</strong> </span></li>
                    <li><i class="fa-solid fa-circle-check"></i><span><strong>Make your order</strong> </span></li>
                </ul>

                <div class="d-flex flex-wrap gap-3">
                    <button type="button" class="btn btn-orange btn-lg" data-bs-toggle="modal" data-bs-target="#loginModal">
                        <i class="fa-solid fa-right-to-bracket me-2"></i> Login
                    </button>
                    <a asp-page="/Customer/Register" class="btn btn-outline-dark-pill btn-lg">
                        <i class="fa-solid fa-user-plus me-2"></i> Register
                    </a>
                </div>

            </div>

            <div class="col-lg-6">
                <div class="hero-arch-wrap">
                    <div class="arch-backdrop"></div>

                    <div class="img-slot hero-arch">
                        <i class="fa-solid fa-image slot-icon"></i>
                        <img src="~/images/restaurant.jpg" alt="Delicious food at MyCafe" onerror="this.remove()" />
                    </div>

                    <!-- Rotating badge -->
                    <div class="hero-sticker" aria-hidden="true">
                        <svg viewBox="0 0 120 120">
                            <defs>
                                <path id="stickerCircle" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" />
                            </defs>
                            <circle cx="60" cy="60" r="58" />
                            <text><textPath href="#stickerCircle" textLength="272" lengthAdjust="spacing">RESERVE • ORDER • ENJOY • </textPath></text>
                        </svg>
                        <i class="fa-solid fa-utensils"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- ===== Dishes ===== -->
<section class="section section-alt" id="dishes">
    <div class="container">
        <div class="section-head">
            <h2>Our Dishes</h2>
            <p>Explore our variety of dishes.</p>
        </div>

        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                <div class="dish-card">
                    <div class="img-slot dish-img"><i class="fa-solid fa-bowl-food slot-icon"></i><img src="~/images/salad.jpg" alt="Pizza" onerror="this.remove()" /></div>
                    <div class="dish-body"><h5>Salads</h5><p>Tasty and fresh salad.</p></div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="dish-card">
                    <div class="img-slot dish-img"><i class="fa-solid fa-cup-togo slot-icon"></i><img src="~/images/drinks.jpg" alt="Dessert" onerror="this.remove()" /></div>
                    <div class="dish-body"><h5>Drinks</h5><p>Refreshing beverages. Coffee or non-coffee</p></div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="dish-card">
                    <div class="img-slot dish-img"><i class="fa-solid fa-burger slot-icon"></i><img src="~/images/burger.jpg" alt="Burger" onerror="this.remove()" /></div>
                    <div class="dish-body"><h5>Burger</h5><p>Made fresh.</p></div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="dish-card">
                    <div class="img-slot dish-img"><i class="fa-solid fa-pizza-slice slot-icon"></i><img src="~/images/pizza.jpg" alt="Pizza" onerror="this.remove()" /></div>
                    <div class="dish-body"><h5>Pizza</h5><p>Crispy crust.</p></div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="dish-card">
                    <div class="img-slot dish-img"><i class="fa-solid fa-fish slot-icon"></i><img src="~/images/sushi.jpg" alt="Sushi" onerror="this.remove()" /></div>
                    <div class="dish-body"><h5> Sushi</h5><p>Delicate flavours, beautifully rolled.</p></div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="dish-card">
                    <div class="img-slot dish-img"><i class="fa-solid fa-ice-cream slot-icon"></i><img src="~/images/dessert.jpg" alt="Dessert" onerror="this.remove()" /></div>
                    <div class="dish-body"><h5>Sweet Desserts</h5><p>The perfect way to end your meal.</p></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== How it works ===== -->
<section class="section" id="how">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">Simple Steps</span>
            <h2>How It Works</h2>
        </div>

        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="step"><div class="step-no">1</div><h5>Create an account</h5><p>Register and log in from this page.</p></div>
            </div>
            <div class="col-md-4">
                <div class="step"><div class="step-no">2</div><h5>Reserve a table and order your dish</h5><p>Explore the menu and choose a time that suits you.</p></div>
            </div>
            <div class="col-md-4">
                <div class="step"><div class="step-no">3</div><h5>Come to the restaurant at your desired time</h5><p>We prepare everything so you can simply enjoy the meal.</p></div>
            </div>
        </div>
    </div>
</section>

<!-- ===== CTA ===== -->
<section class="container">
    <div class="cta-band">
        <div>
            <h3>Ready to dine with us?</h3>
            <p class="mb-0">Log in or create a free account to get started.</p>
        </div>
        <div class="d-flex flex-wrap gap-3">
            <button type="button" class="btn btn-light-pill" data-bs-toggle="modal" data-bs-target="#loginModal">Login</button>
            <a asp-page="/Customer/Register" class="btn btn-dark-pill">Register Now</a>
        </div>
    </div>
</section>

<!-- ===== LOGIN MODAL ===== -->
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="loginModalLabel">
                    <i class="fa-solid fa-right-to-bracket me-2 text-warning"></i>Sign In
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                @if (ViewData["LoginError"] != null)
                {
                    <div class="alert alert-danger small py-2">@ViewData["LoginError"]</div>
                }

                @if (ViewData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success small py-2">@ViewData["SuccessMessage"]</div>
                }

                @if (!Model.RequireOtp)
                {
                    <!-- STEP 1: Email & Password -> Button says LOGIN -->
                    <form method="post" asp-page-handler="Login">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Email or Username</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                                <input asp-for="LoginEmail" class="form-control" placeholder="Enter your email" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                <input asp-for="LoginPassword" type="password" class="form-control" placeholder="Enter your password" required />
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-warning text-white fw-bold py-2">LOGIN</button>
                        </div>
                    </form>
                }
                else
                {
                    <!-- STEP 2: Appears after entering email & password correctly, requesting OTP code -->
                    <form method="post" asp-page-handler="VerifyLoginOtp">
                        <div class="alert alert-warning small py-2 mb-3">
                            <i class="fa-solid fa-envelope me-1"></i> A 6-digit verification code has been sent to your email.
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Verification Code</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-shield-keyhole"></i></span>
                                <input asp-for="LoginOtp" class="form-control text-center fw-bold fs-5" placeholder="6-Digit Code" maxlength="6" required autofocus />
                            </div>
                            <span asp-validation-for="LoginOtp" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <button type="submit" asp-page-handler="CancelOtp" class="btn btn-outline-secondary btn-sm" formnovalidate>Back</button>
                            <button type="submit" class="btn btn-warning text-white fw-bold py-2 px-4">VERIFY &amp; LOGIN</button>
                        </div>
                    </form>
                }
            </div>

            <div class="modal-footer border-0 justify-content-center bg-light rounded-bottom-4 py-3">
                <span class="small text-muted">Don't have an account?</span>
                <a asp-page="/Customer/Register" class="small fw-bold text-warning text-decoration-none ms-1">Register Now</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (ViewData["OpenLogin"] != null && (bool)ViewData["OpenLogin"]!)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
                loginModal.show();
            });
        </script>
    }
}