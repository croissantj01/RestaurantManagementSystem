<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MyCafe Staff</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/staff.css" asp-append-version="true" />
</head>

<body>

    <nav class="staff-navbar">
        <div class="staff-navbar-inner">

            <a class="staff-brand" asp-page="/Staff/Dashboard">
                <span class="brand-icon">
                    <i class="fa-solid fa-utensils"></i>
                </span>
                MyCafe
            </a>

            <div class="staff-nav-links">
                <a asp-page="/Staff/Dashboard">Home</a>
                <a asp-page="/Staff/Reservation">Reservations</a>
                <a asp-page="/Staff/Order">Orders</a>
                <a asp-page="/Staff/Payment">Payments</a>
            </div>

            <div class="staff-user-section">
                <div class="staff-welcome">
                    <span>Welcome back,</span>
                    <strong>Staff</strong>
                </div>

                <form method="post"
                      asp-page="/Staff/Dashboard"
                      asp-page-handler="Logout">
                    <button type="submit" class="staff-logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Logout
                    </button>
                </form>
            </div>

        </div>
    </nav>

    <main class="staff-content">
        @RenderBody()
    </main>

   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>



