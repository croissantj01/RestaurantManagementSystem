<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyCafe Admin</title>

    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Shared admin styles -->
    <link rel="stylesheet" href="~/AdminDashboard.css" asp-append-version="true" />

    <!-- Page-specific styles -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @{
        var active = ViewData["ActiveNav"] as string;
    }

    <!-- Admin Navigation Bar (shared by every admin page) -->
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-page="/Admin/Dashboard">
                <span><i class="fa-solid fa-utensils"></i></span> MyCafe
                <small class="admin-badge">Admin</small>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link @(active == "Dashboard" ? "active" : "")" asp-page="/Admin/Dashboard">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(active == "Tables" ? "active" : "")" asp-page="/Admin/RestaurantTables/Index">Tables</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(active == "Staff" ? "active" : "")" asp-page="/Admin/ManageStaff/ManageStaff">Manage Staff</a>
                    </li>
                    <li class="nav-item">
    <a class="nav-link @(active == "ManageCustomer" ? "active" : "")" asp-page="/Admin/ManageCustomer">View Customers</a>
</li>
<li class="nav-item">
    <a class="nav-link @(active == "Announcements" ? "active" : "")" asp-page="/Admin/Announcements">Announcements</a>
</li>

                    <li class="nav-item">
                        <a class="nav-link @(active == "Menu" ? "active" : "")" asp-page="/Admin/ManageMenu">Menu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Admin/Reports/Index" asp-fragment="report-section">Reports</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end">
                        <span class="d-block text-muted" style="font-size: 0.8rem;">Signed in as</span>
                        <strong class="text-dark">Administrator</strong>
                    </div>
                    <form method="post" asp-page="/Admin/Dashboard" asp-page-handler="Logout" class="m-0">
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2">
                            <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <!-- Page content -->
    <div class="container my-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>